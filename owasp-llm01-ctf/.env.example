# ============================================================================
# Configuración opcional del laboratorio PromptMe CTF
# Copia este archivo a `.env` y rellena los valores que necesites.
# SIN ninguna de estas variables el laboratorio funciona en modo simulado
# (offline, determinista, costo $0).
# ============================================================================

# Clave secreta de Flask para firmar sesiones (cámbiala en entornos reales).
FLASK_SECRET_KEY=cambia-esto-por-una-clave-aleatoria-larga

# --- APIs reales opcionales (el laboratorio sigue funcionando sin ellas) ----
# Gemini (Google AI Studio — capa gratuita): https://aistudio.google.com/apikey
# GEMINI_API_KEY=tu_api_key_de_gemini
# GEMINI_MODEL=gemini-2.0-flash

# Groq (capa gratuita): https://console.groq.com/keys
# GROQ_API_KEY=tu_api_key_de_groq
# Recomendado: qwen/qwen3.8-27b (susceptible a inyección -> ideal para el CTF).
# Los modelos gpt-oss de OpenAI en Groq están blindados y rechazan los ataques.
# GROQ_MODEL=qwen/qwen3.8-27b
